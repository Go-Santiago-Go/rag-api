# Every environment variable the service reads, with the defaults it falls back to.
#
# The binary reads the process environment directly; it does not parse this file.
# `make run` and the `make eval-*` targets load a `.env` sitting next to this one,
# so the usual workflow is: cp .env.example .env, edit, make run.

# --- Database -----------------------------------------------------------------
# Resolved most-specific-first, so one binary serves both environments.
#
#   1. DATABASE_URL set    -> used verbatim. The local path.
#   2. PGHOST set, no URL  -> pgx reads the PG* vars below. The cloud path: ECS
#                             injects PGPASSWORD from Secrets Manager, so the
#                             password never enters the image or Terraform state.
#   3. neither set         -> the local docker-compose default shown here.

DATABASE_URL=postgres://postgres:localdev@localhost:5432/go_rag_api?sslmode=disable

# Leave these unset locally. They are what ECS sets in the cloud, listed so the
# full contract is visible in one place.
# PGHOST=
# PGUSER=postgres
# PGPASSWORD=
# PGDATABASE=go_rag_api
# PGSSLMODE=require

# --- AWS ----------------------------------------------------------------------
# Credentials are not set here. The SDK walks its standard chain (environment,
# ~/.aws, then an IAM role), which is what lets the same binary use local creds
# on a laptop and the task role on Fargate with no code change.
#
# The region must have model access granted for Titan Text Embeddings V2,
# Cohere Rerank v3.5, and a Claude model. Bedrock is opt in per account.

AWS_REGION=us-east-1
# AWS_PROFILE=default

# --- Chunking -----------------------------------------------------------------
# The defaults are the measured configuration; see eval/README.md. Changing any
# of these requires re-ingesting, because chunking happens at ingest time.

CHUNK_STRATEGY=structured   # structured (split on markdown headings) or fixed
CHUNK_SIZE=800              # maximum chunk size in runes
CHUNK_OVERLAP=80            # overlap between fixed-size chunks, in runes

# --- Tests --------------------------------------------------------------------
# Optional. The pgvector store test is skipped unless this points at a throwaway
# database. Every other test runs with no database and no cloud access.
# TEST_DATABASE_URL=postgres://postgres:localdev@localhost:5432/go_rag_api?sslmode=disable

# Note: the listen port is not configurable. The service binds :8080, which the
# container image and the ECS target group both assume.
